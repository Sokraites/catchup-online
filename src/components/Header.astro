---
import { site, navigation } from '../config/site';
import Logo from './Logo.astro';
import Auge from './Auge.astro';
import StufenSchalter from './StufenSchalter.astro';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label={`${site.name}, zur Startseite`}>
      <Logo size={30} />
      <span>{site.name}</span>
    </a>
    <Auge />
    <nav class="main-nav" aria-label="Hauptnavigation">
      <ul class="nav-list">
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="button button-small header-cta" href="/termin/">Termin <span class="cta-rest">buchen</span></a>
    <StufenSchalter />
  </div>
</header>
