---
import '../styles/global.css';
import { site, INDEXIERUNG } from '../config/site';
import { graph, organisation } from '../lib/schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Kacheln from '../components/Kacheln.astro';
import Terminbuch from '../components/Terminbuch.astro';
import StufenWahl from '../components/StufenWahl.astro';
import { standardStufe, stufenSchluessel } from '../config/stufen';

interface Props {
  /** Seitentitel ohne Firmennamen; der Name wird angehängt. */
  title?: string;
  description?: string;
  /** Suchmaschinen sollen die Seite nicht aufnehmen (z. B. 404). */
  noindex?: boolean;
  /** Zusätzliche Schema.org-Einträge dieser Seite. Die Organisation ist immer dabei. */
  schema?: object[];
}

const { title, description = site.beschreibung, noindex = false, schema = [] } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.claim}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = `${site.url}/og.png`;
const jsonLd = JSON.stringify(graph(organisation(), ...schema));
---

<!doctype html>
<html lang={site.sprache}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Darstellungs-Stufe sofort setzen, damit nichts umspringt (leicht, mittel, schwer) -->
    <script is:inline define:vars={{ schluessel: stufenSchluessel, standard: standardStufe }}>
      var h = document.documentElement;
      var s = null;
      try {
        s = new URLSearchParams(location.search).get('stufe');
        if (s) localStorage.setItem(schluessel, s);
        else s = localStorage.getItem(schluessel);
      } catch (e) {}
      if (!s && window.name.indexOf(schluessel + ':') === 0) s = window.name.slice(schluessel.length + 1);
      if (!/^(leicht|mittel|schwer)$/.test(s || '')) {
        s = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'leicht' : standard;
        h.dataset.stufeOffen = '';
      }
      h.dataset.stufe = s;
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Schalter INDEXIERUNG: solange er aus ist, sollen Suchmaschinen keine Seite aufnehmen */}
    {(noindex || !INDEXIERUNG) && <meta name="robots" content={INDEXIERUNG ? 'noindex' : 'noindex, nofollow'} />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0D0D13" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/logo.png" />
    {INDEXIERUNG && <link rel="sitemap" href="/sitemap.xml" />}
    <link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.claim}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={jsonLd} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Kacheln />
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
    <Terminbuch />
    <StufenWahl />
    <script>
      import { starteStufenWahl } from '../scripts/stufe';
      starteStufenWahl();
    </script>
  </body>
</html>
