---
import Base from '../layouts/Base.astro';
import AkzentWort from '../components/AkzentWort.astro';
import Platzhalter from '../components/Platzhalter.astro';
import { site } from '../config/site';
import { brotkrumen } from '../lib/schema';

const { telefon, email } = site.kontakt;
---

<Base
  title="Termin buchen"
  description={`Vereinbare ein Gespräch mit ${site.name} über deine Webseite.`}
  schema={[brotkrumen('Termin buchen', '/termin/')]}
>
  <section class="hero hero-sub" aria-labelledby="seite-titel">
    <div class="wrap">
      <h1 id="seite-titel">Termin buchen</h1>
      <AkzentWort />
      <p class="lead">
        In einem Gespräch erzählst du uns von deinem Betrieb, und wir sagen dir, was deine Webseite für dich tun kann.
      </p>
      <p><a class="button" href="/termin/" data-tb-auto>Terminbuch aufschlagen</a></p>
      <p>Lieber direkt? Ruf an oder schreib uns:</p>
      <ul class="kontakt-liste">
        <li>
          <strong>Telefon:</strong>
          {telefon.link ? <a href={`tel:${telefon.link}`}>{telefon.anzeige.text}</a> : <Platzhalter wert={telefon.anzeige} />}
        </li>
        <li>
          <strong>E-Mail:</strong> <a href={`mailto:${email.text}?subject=Terminanfrage`}><Platzhalter wert={email} /></a>
        </li>
      </ul>
    </div>
  </section>
</Base>

<script>
  // Auf dieser Seite schlägt sich das Terminbuch gleich von selbst auf.
  addEventListener('load', () => document.querySelector<HTMLAnchorElement>('[data-tb-auto]')?.click());
</script>
