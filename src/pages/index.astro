---
import Base from '../layouts/Base.astro';
import StartInhalt from '../components/StartInhalt.astro';
import BrowserLeisten from '../components/BrowserLeisten.astro';
import MonitorGehaeuse from '../components/MonitorGehaeuse.astro';
import '../styles/monitor.css';
import { faqStart } from '../content/faq';
import { faqSeite, website } from '../lib/schema';
---

<!--
  Startseite mit Monitor-Zeitreise.
  Ohne JavaScript oder bei reduzierter Bewegung ist das hier eine ganz normale Seite:
  Alle Abschnitte stehen als echter Text untereinander.
-->
<Base schema={[website(), faqSeite(faqStart)]}>
  <div class="buehne" data-monitor>
    <div class="monitor">
      <div class="monitor-geraet" data-epoche="0">
        <div class="monitor-schirm">
          <BrowserLeisten />
          <div class="monitor-flaeche">
            <StartInhalt />
          </div>
          <!-- Unterseite in einem Tab des Monitor-Browsers (vom Skript gefüllt) -->
          <div class="monitor-tab-seite" data-tab-seite hidden>
            <p class="tab-kopf">
              <button type="button" class="tab-zurueck" data-tab-zurueck>← Zurück zur Übersicht</button>
            </p>
            <div data-tab-inhalt></div>
          </div>
        </div>
        <div class="monitor-glas" aria-hidden="true"></div>
        <MonitorGehaeuse />
      </div>
      <p class="monitor-tipp" aria-hidden="true">Scrollen</p>
    </div>
  </div>
</Base>

<script>
  import { starteMonitor } from '../scripts/monitor';
  import { starteMonitorTabs } from '../scripts/monitor-tabs';
  import { stufe } from '../scripts/stufe';

  // Stufe „Schwer“ am Desktop: Aussicht durchs Fenster neben dem Monitor (Platz schon vor dem ersten Aufbau schaffen)
  const AUSSICHT = '(min-width: 1280px) and (pointer: fine) and (prefers-reduced-motion: no-preference)';
  const html = document.documentElement;
  const mitAussicht = stufe() === 'schwer' && matchMedia(AUSSICHT).matches && 'WebGL2RenderingContext' in window;
  // Fällt die Aussicht aus (kein WebGL, Foto lädt nicht), steht der Monitor wieder in voller Breite.
  const ohneAussicht = () => {
    html.classList.remove('aussicht-an');
    dispatchEvent(new Event('monitor-neu'));
  };
  if (mitAussicht) html.classList.add('aussicht-an');
  starteMonitorTabs(starteMonitor());
  if (mitAussicht) {
    // erst laden, wenn die Seite steht: Der Inhalt hat Vorrang
    const los = () =>
      import('../scripts/aussicht').then(({ starteAussicht }) => {
        if (!starteAussicht(ohneAussicht)) ohneAussicht();
      });
    if ('requestIdleCallback' in window) requestIdleCallback(los, { timeout: 2000 });
    else setTimeout(los, 500);
  }
</script>
