---
import Base from '../layouts/Base.astro';
import { navigation } from '../config/site';
---

<Base title="Seite nicht gefunden" description="Diese Adresse gibt es nicht. Von hier geht es zurück zur Startseite oder direkt zu unseren Leistungen." noindex>
  <section class="section" aria-labelledby="seite-titel">
    <div class="wrap">
      <h1 id="seite-titel">Diese Seite gibt es nicht (mehr).</h1>
      <p><a class="button" href="/">Zur Startseite</a></p>
      <p>Oder direkt weiter zu:</p>
      <ul>
        {navigation.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/termin/">Termin buchen</a></li>
      </ul>
    </div>
  </section>
</Base>
