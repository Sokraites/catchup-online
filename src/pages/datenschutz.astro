---
import Base from '../layouts/Base.astro';
import Platzhalter from '../components/Platzhalter.astro';
import EntwurfVermerk from '../components/EntwurfVermerk.astro';
import { site, type Wert } from '../config/site';
import { stufenSchluessel } from '../config/stufen';

const r = site.rechtliches;
const { telefon, email } = site.kontakt;
const offen = (was: string): Wert => ({ text: `<<HIER ANGABE EINTRAGEN: ${was}>>`, platzhalter: true });
---

<Base title="Datenschutz" description={`Datenschutzerklärung von ${site.name}.`}>
  <section class="section legal" aria-labelledby="seite-titel">
    <div class="wrap">
      <EntwurfVermerk />
      <h1 id="seite-titel">Datenschutzerklärung</h1>

      <h2>1. Verantwortlicher</h2>
      <p>
        <Platzhalter wert={r.firma} /><br />
        <Platzhalter wert={r.vertretung} /><br />
        <Platzhalter wert={r.anschrift} /><br />
        Telefon: <a href={`tel:${telefon.link}`}><Platzhalter wert={telefon.anzeige} /></a><br />
        E-Mail: <a href={`mailto:${email.text}`}><Platzhalter wert={email} /></a>
      </p>

      <h2>2. Das Wichtigste in Kürze</h2>
      <p>
        Diese Webseite setzt keine Cookies, nutzt keine Analyse- oder Werbedienste und lädt nichts von fremden Servern.
        Schriften, Bilder und Programmteile werden vom selben Server ausgeliefert wie die Seite selbst.
      </p>

      <h2>3. Hosting und Server-Logfiles</h2>
      <p>Die Webseite wird betrieben bei: <Platzhalter wert={r.hosting} /></p>
      <p>
        Beim Aufruf der Seite verarbeitet der Server technisch notwendige Angaben, die dein Browser von selbst übermittelt
        (Server-Logfiles): IP-Adresse, Datum und Uhrzeit des Abrufs, aufgerufene Adresse, übertragene Datenmenge,
        Browser und Betriebssystem sowie gegebenenfalls die zuvor besuchte Seite. Das ist nötig, um die Seite
        auszuliefern und vor Missbrauch zu schützen (Art. 6 Abs. 1 lit. f DSGVO).
      </p>
      <p>Speicherdauer der Logfiles: <Platzhalter wert={offen('Speicherdauer laut Hosting-Anbieter')} /></p>

      <h2>4. Kontakt per E-Mail oder Telefon</h2>
      <p>
        Wenn du uns schreibst oder anrufst, verarbeiten wir deine Angaben (zum Beispiel Name, Kontaktdaten und dein
        Anliegen), um deine Anfrage zu beantworten (Art. 6 Abs. 1 lit. b DSGVO bei Anfragen zu einem möglichen Auftrag,
        sonst Art. 6 Abs. 1 lit. f DSGVO). Wir löschen die Angaben, wenn sie dafür nicht mehr gebraucht werden und keine
        gesetzlichen Aufbewahrungspflichten bestehen.
      </p>
      <p>Unser E-Mail-Postfach liegt bei: <Platzhalter wert={offen('E-Mail-Anbieter mit Anschrift')} /></p>

      <h2>5. Terminbuch</h2>
      <p>
        Das Terminbuch auf dieser Seite sendet nichts an uns. Wenn du einen Termin anfragst, bereitet es eine E-Mail in
        deinem eigenen E-Mail-Programm vor. Erst wenn du diese E-Mail selbst abschickst, erhalten wir deine Angaben; dann
        gilt Abschnitt 4.
      </p>

      <h2>6. Gespeicherte Darstellung auf deinem Gerät</h2>
      <p>
        Wenn du oben rechts eine Darstellung (Leicht, Mittel, Schwer) wählst, merkt sich dein Browser diese Wahl in
        seinem lokalen Speicher (Eintrag „{stufenSchluessel}“). Ist dieser Speicher gesperrt, gilt die Wahl nur, solange
        der Tab geöffnet ist. Der Eintrag wird nicht an uns oder andere übertragen. Du kannst ihn jederzeit über die
        Einstellungen deines Browsers löschen.
      </p>

      <h2>7. Deine Rechte</h2>
      <p>
        Du hast das Recht auf Auskunft über deine bei uns gespeicherten Daten (Art. 15 DSGVO), auf Berichtigung (Art. 16),
        Löschung (Art. 17), Einschränkung der Verarbeitung (Art. 18), Datenübertragbarkeit (Art. 20) und kannst einer
        Verarbeitung auf Grundlage von Art. 6 Abs. 1 lit. f DSGVO widersprechen (Art. 21). Eine Nachricht an die oben
        genannte E-Mail-Adresse genügt.
      </p>

      <h2>8. Beschwerderecht</h2>
      <p>
        Du kannst dich bei einer Datenschutz-Aufsichtsbehörde beschweren (Art. 77 DSGVO), zum Beispiel beim
        Landesbeauftragten für den Datenschutz und die Informationsfreiheit Rheinland-Pfalz.
      </p>
    </div>
  </section>
</Base>
