---
import Base from '../../layouts/Base.astro';
import StartInhalt from '../../components/StartInhalt.astro';
import BrowserLeisten from '../../components/BrowserLeisten.astro';
import MonitorGehaeuse from '../../components/MonitorGehaeuse.astro';
import '../../styles/monitor.css';
---

<!--
  Entwurf „Monitor-Zeitreise“. Nicht für Suchmaschinen (noindex, nicht in der Sitemap).
  Ohne JavaScript oder bei reduzierter Bewegung ist das hier die ganz normale Startseite.
-->
<Base title="Entwurf: Monitor-Zeitreise" noindex>
  <div class="buehne" data-monitor>
    <div class="monitor">
      <div class="monitor-geraet" data-epoche="0">
        <div class="monitor-schirm">
          <BrowserLeisten />
          <div class="monitor-flaeche">
            <StartInhalt />
          </div>
        </div>
        <div class="monitor-glas" aria-hidden="true"></div>
        <MonitorGehaeuse />
      </div>
      <p class="monitor-tipp" aria-hidden="true">Scrollen</p>
    </div>
  </div>
</Base>

<script>
  import { starteMonitor } from '../../scripts/monitor';
  starteMonitor();
</script>
