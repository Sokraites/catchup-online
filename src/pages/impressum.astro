---
import Base from '../layouts/Base.astro';
import Platzhalter from '../components/Platzhalter.astro';
import EntwurfVermerk from '../components/EntwurfVermerk.astro';
import { site } from '../config/site';

const r = site.rechtliches;
const { telefon, email } = site.kontakt;
---

<Base title="Impressum" description={`Impressum von ${site.name}: Anbieterangaben nach § 5 DDG und Kontakt per Telefon und E-Mail.`}>
  <section class="section legal" aria-labelledby="seite-titel">
    <div class="wrap">
      <EntwurfVermerk />
      <h1 id="seite-titel">Impressum</h1>

      <h2>Angaben gemäß § 5 DDG</h2>
      <p>
        <Platzhalter wert={r.firma} /><br />
        <Platzhalter wert={r.anschrift} />
      </p>

      <h2>Vertreten durch</h2>
      <p><Platzhalter wert={r.vertretung} /></p>

      <h2>Kontakt</h2>
      <p>
        Telefon: <a href={`tel:${telefon.link}`}><Platzhalter wert={telefon.anzeige} /></a><br />
        E-Mail: <a href={`mailto:${email.text}`}><Platzhalter wert={email} /></a>
      </p>

      <h2>Registereintrag</h2>
      <p><Platzhalter wert={r.register} /></p>

      <h2>Umsatzsteuer-Identifikationsnummer</h2>
      <p><Platzhalter wert={r.ustId} /></p>

      <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
      <p><Platzhalter wert={r.inhaltlichVerantwortlich} /></p>
    </div>
  </section>
</Base>
